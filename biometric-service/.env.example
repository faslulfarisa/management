# ===========================================
# Biometric Attendance Microservice Configuration
# ===========================================

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8100
DEBUG=true
LOG_LEVEL=INFO
SERVICE_NAME=biometric-attendance-service

# Database (separate from Ai-HRMS core)
DATABASE_URL=postgresql+asyncpg://biometric_user:biometric_pass@localhost:5432/biometric_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Sync Database URL (for Alembic - synchronous driver)
SYNC_DATABASE_URL=postgresql://biometric_user:biometric_pass@localhost:5432/biometric_db

# Redis (shared instance, different DB number to avoid collisions)
REDIS_URL=redis://localhost:6379/1

# Ai-HRMS Integration (callback to push processed attendance)
HMS_BASE_URL=http://localhost:3001/api
HMS_API_KEY=biometric-service-key-change-in-production
HMS_CALLBACK_ENABLED=true

# pyzk Device Defaults
PYZK_CONNECT_TIMEOUT=10
PYZK_READ_TIMEOUT=30
PYZK_MAX_RETRIES=3
PYZK_DEFAULT_PORT=4370

# Sync Schedule (seconds)
SYNC_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=120
PROCESS_INTERVAL_SECONDS=180

# Attendance Engine
DUPLICATE_PUNCH_THRESHOLD_MINUTES=2
DEFAULT_GRACE_PERIOD_MINUTES=15
DEFAULT_OVERTIME_THRESHOLD_MINUTES=30
DEFAULT_HALF_DAY_THRESHOLD_MINUTES=240
DEFAULT_MIN_WORK_HOURS=8.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
