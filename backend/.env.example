# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://hms_user:hms_password@localhost:5432/hms_db
# Pool size — keep at or below your Postgres provider's connection cap
# (e.g. Supabase Session Pooler) divided by the number of backend replicas.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# Queries slower than this are logged at warn level (ms)
DATABASE_SLOW_QUERY_MS=200
# Requests slower than this are logged at warn level (ms)
SLOW_REQUEST_MS=1000
# Compress JSON/text responses larger than this many bytes
RESPONSE_COMPRESSION_THRESHOLD_BYTES=1024
# Cache headers for locally served uploads when STORAGE_DRIVER=local
LOCAL_UPLOADS_CACHE_MAX_AGE=1d

# Permission/role lookup cache TTL — short on purpose: bounds how long a
# revoked permission can remain effective if an invalidation path is missed.
PERMISSIONS_CACHE_TTL_SECONDS=60

# Redis — set to false to run without Redis/Bull (queue features degrade gracefully).
# Recommended for local development if you don't have Redis installed.
REDIS_ENABLED=false

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Storage driver: 'local' (disk, no MinIO needed) or 'minio'
STORAGE_DRIVER=local

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hms-documents
MINIO_USE_SSL=false

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hms.com

# SMS
SMS_PROVIDER=2factor
SMS_API_KEY=

# WhatsApp
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RazorpayX current account number (required for payout creation)
RAZORPAY_ACCOUNT_NUMBER=
# Webhook secret configured in Razorpay dashboard → Webhooks → Active Secret
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# ZKTeco
ZKTECO_API_URL=
ZKTECO_API_KEY=

# Redis connection (only used when REDIS_ENABLED=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Credential encryption (AES-256-GCM)
CREDENTIAL_MASTER_KEY=
